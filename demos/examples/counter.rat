<script>
  let   $count  = 0;
  const $double = $count * 2;

  const inc   = () => $count++;
  const reset = () => $count = 0;
</script>

<div.counter>
  <button onclick={inc}>+1</button>
  <output>{$count} × 2 = {$double}</output>
  <button onclick={reset} disabled={!$count}>reset</button>
</div.counter>

<style>
  .counter { align-items: center; display: flex; gap: .5rem; }
  output   { font-variant-numeric: tabular-nums; min-width: 10ch; }
</style>
