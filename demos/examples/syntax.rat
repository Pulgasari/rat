<script>
  let $view = 'grid';
  let $size = 3;

  const views = ['grid', 'list', 'table'];
  const items = ['ratte', 'maus', 'hamster'];
</script>

<main#tour.tour>
  <h2 title|aria-label="tag-selektoren und prop-gruppen">syntax-tour</h2>

  <nav>
    @for (view, index of views) {
      <button class:active={$view === view} onclick={() => $view = view}>{index + 1}. {view}</button>
    }
  </nav>

  @switch ($view) {
    @case 'grid' { <.grid>@for (item of items) { <.cell>{item}</.cell> }</.grid> }
    @case 'list' { <ul>@for (item of items): <li>{item}</li></ul> }
    @default     { <p>"{$view}" gibt es noch nicht</p> }
  }

  <label>
    größe: {$size}
    <input type="range" min="1" max="5" bind:value={$size} />
  </label>

  <svg viewBox="0 0 100 20" width="250">
    @for (n of Array.from({ length: Number($size) }, (_, i) => i)) {
      <circle cx={10 + n * 20} cy="10" r="8" />
    }
  </svg>
</main#tour>

<style>
  .tour   { display: grid; gap: 1rem; }
  .grid   { display: grid; gap: .5rem; grid-template-columns: repeat(3, 1fr); }
  .cell   { background: #8884; padding: 1rem; text-align: center; }
  .active { outline: 2px solid currentcolor; }
  circle  { fill: crimson; }
</style>
