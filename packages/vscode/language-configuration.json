{
  "comments": { "lineComment": "//", "blockComment": ["<!--", "-->"] },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"], ["<", ">"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] },
    { "open": "`", "close": "`", "notIn": ["string"] },
    { "open": "<!--", "close": "-->", "notIn": ["comment", "string"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"], ["`", "`"], ["<", ">"]],
  "indentationRules": {
    "increaseIndentPattern": "(\\{[^}\"'`]*$)|(<(?!(?:area|base|br|col|embed|hr|img|input|link|meta|source|track|wbr)\\b)[\\w.#$-]+(?:[^>]*[^/])?>[^<]*$)|(^\\s*@(?:if|else|for|switch|case|default)\\b[^{:]*$)",
    "decreaseIndentPattern": "^\\s*(\\}|</)"
  }
}
