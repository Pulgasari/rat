{
  "name": "@rat/syntax",
  "version": "0.0.1",
  "description": "syntax highlighting for rat from one source of truth: hljs, monaco, codemirror, textmate, zed",
  "type": "module",
  "main": "./spec.js",
  "exports": {
    ".": "./spec.js",
    "./codemirror": "./targets/codemirror.js",
    "./hljs": "./targets/hljs.js",
    "./hljs/*": "./hljs/*",
    "./monaco": "./targets/monaco.js",
    "./textmate": "./targets/textmate.js"
  },
  "scripts": {
    "build": "node build.js"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "highlight.js": "^11.10.0",
    "tree-sitter-cli": "^0.25.10"
  },
  "license": "MIT"
}
