    "attribute_name": {
      "type": "PATTERN",
      "value": "([^\\s=\\/>\"'{}|.#\\[]|\\[[^\\]\\n]*\\])([^\\s=\\/>\"'{}|\\[]|\\[[^\\]\\n]*\\])*"
