    "text": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "[^<{}@&:\\s][^<{}@&]*"
          },
          {
            "type": "PATTERN",
            "value": "[@&:]"
          }
        ]
      }
    },
    "template_text": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "[^<{}@&:`$\\s][^<{}@&`$]*"
          },
          {
            "type": "PATTERN",
            "value": "[@&:$]"
          }
        ]
      }
    },
    "entity": {
      "type": "PATTERN",
      "value": "&(#\\d+|#x[0-9a-fA-F]+|[a-zA-Z]+);"
    },
