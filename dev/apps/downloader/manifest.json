{
  "id": "downloader",
  "name": "Downloader",
  "short_name": "Downloader",
  "description": "A downloads manager.",
  "lang": "en",
  "dir": "ltr",
  "scope": "./",
  "start_url": "./",
  "display": "standalone",
  "orientation": "any",
  "categories": [
    "files",
    "network"
  ],
  "background_color": "#282a36",
  "theme_color": "#282a36",
  "icons": [
    {
      "src": "./assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "text": "text",
      "title": "title",
      "url": "url"
    }
  }
}
