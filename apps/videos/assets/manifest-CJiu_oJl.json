{
  "id": "videos",
  "name": "Videos",
  "short_name": "Videos",
  "description": "A videos manager and player.",
  "lang": "en",
  "dir": "ltr",
  "scope": "./",
  "start_url": "./",
  "display": "standalone",
  "orientation": "any",
  "categories": [
    "media"
  ],
  "background_color": "#282a36",
  "theme_color": "#282a36",
  "icons": [
    {
      "src": "./assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "video/mp4": [
          ".mp4",
          ".m4v"
        ],
        "video/webm": [
          ".webm"
        ],
        "video/quicktime": [
          ".mov"
        ],
        "video/x-matroska": [
          ".mkv"
        ],
        "video/x-msvideo": [
          ".avi"
        ],
        "video/ogg": [
          ".ogv"
        ],
        "video/mpeg": [
          ".mpg",
          ".mpeg"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "shortcuts": [
    {
      "name": "Library",
      "short_name": "Library",
      "url": "./#/"
    },
    {
      "name": "Player",
      "short_name": "Player",
      "url": "./#/player"
    },
    {
      "name": "Edit",
      "short_name": "Edit",
      "url": "./#/edit"
    }
  ]
}
